// ============================================================
//  CareSphere — Firestore Security Rules
//  Deploy via:  firebase deploy --only firestore:rules
//  Or paste into Firebase Console → Firestore → Rules tab
// ============================================================
//
//  Collections & access model:
//  ┌─────────────────────────┬─────────────┬────────────────┐
//  │ Collection              │ Public read │ Write          │
//  ├─────────────────────────┼─────────────┼────────────────┤
//  │ blogs                   │ ✅ published │ 🔐 admin only  │
//  │ services                │ ✅ published │ 🔐 admin only  │
//  │ events                  │ ✅ published │ 🔐 admin only  │
//  │ resources               │ ✅ published │ 🔐 admin only  │
//  │ team_members            │ ✅ always    │ 🔐 admin only  │
//  │ analytics_pages         │ ❌ private   │ ✅ anyone write │
//  │ analytics_daily         │ ❌ private   │ ✅ anyone write │
//  │ analytics_referrers     │ ❌ private   │ ✅ anyone write │
//  │ admin_users             │ ❌ private   │ 🔐 admin only  │
//  └─────────────────────────┴─────────────┴────────────────┘

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the caller an authenticated admin? ──────
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    // ── BLOGS ──────────────────────────────────────────────
    match /blogs/{docId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    // ── SERVICES ───────────────────────────────────────────
    match /services/{docId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    // ── EVENTS ─────────────────────────────────────────────
    match /events/{docId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    // ── HEALTH RESOURCES ───────────────────────────────────
    match /resources/{docId} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    // ── TEAM MEMBERS ───────────────────────────────────────
    match /team_members/{docId} {
      allow read: if true;   // public
      allow write: if isAdmin();
    }

    // ── ADMIN USERS (whitelist) ────────────────────────────
    match /admin_users/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
      // First admin can self-register via the one-time setup page;
      // subsequent writes require an existing admin.
    }

    // ── ANALYTICS (write-open for tracker.js) ─────────────
    match /analytics_pages/{docId} {
      allow read:  if isAdmin();
      allow write: if true;   // tracker.js writes without auth
    }
    match /analytics_daily/{docId} {
      allow read:  if isAdmin();
      allow write: if true;
    }
    match /analytics_referrers/{docId} {
      allow read:  if isAdmin();
      allow write: if true;
    }
  }
}
